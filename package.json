{
  "name": "open-yard-inventory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Open Yard Inventory - installable no-login PWA over an Apps Script/Google Sheet backend",
  "scripts": {
    "test": "node --test test/deltas.test.mjs test/sync.test.mjs",
    "gate": "node scripts/prepush-gate.mjs",
    "push": "npm run gate && clasp push --force",
    "deploy": "npm run gate && clasp push --force && clasp create-deployment",
    "verify": "node scripts/verify-mobile.mjs && node scripts/verify-flows.mjs",
    "verify:layout": "node scripts/verify-mobile.mjs",
    "verify:flows": "node scripts/verify-flows.mjs",
    "verify:sku": "node scripts/verify-numeric-sku.mjs",
    "smoke": "node scripts/smoke.mjs",
    "shots": "node scripts/shoot.mjs"
  },
  "devDependencies": {}
}
